# API/.env.example
# 复制本文件为 API/.env 后按需填写。
# API/.env 已被 .gitignore 排除，不应提交到版本库。

# 默认生成通道 Comfly
COMFLY_BASE_URL=https://ai.comfly.chat
COMFLY_API_KEY=

# ModelScope
MODELSCOPE_API_KEY=
MODELSCOPE_CHAT_MODELS=

# ARK / 火山方舟
ARK_API_KEY=
VOLCENGINE_ACCESS_KEY_ID=
VOLCENGINE_SECRET_ACCESS_KEY=

# 公网媒体回读（需要外部 API 访问本地素材时配置）
PUBLIC_BASE_URL=
PUBLIC_MEDIA_BASE_URL=
PUBLIC_MEDIA_TOKEN=

# 自定义 API Provider
API_PROVIDER_APIMART_KEY=
API_PROVIDER_LINGJING_KEY=
API_PROVIDER_LINGJING_2_KEY=
API_PROVIDER_EXELLOME_KEY=
API_PROVIDER_CUSTOM_API_KEY=
API_PROVIDER_CUSTOM_API_2_KEY=
API_PROVIDER_CUSTOM_API_3_KEY=
API_PROVIDER_CUSTOM_API_4_KEY=
API_PROVIDER_CUSTOM_API_5_KEY=
API_PROVIDER_CUSTOM_API_6_KEY=
API_PROVIDER_CUSTOM_API_7_KEY=
API_PROVIDER_CUSTOM_API_8_KEY=
API_PROVIDER_CUSTOM_API_9_KEY=
API_PROVIDER_CUSTOM_API_10_KEY=
API_PROVIDER_CUSTOM_API_11_KEY=
API_PROVIDER_CUSTOM_API_12_KEY=
API_PROVIDER_CUSTOM_API_13_KEY=
API_PROVIDER_CUSTOM_API_14_KEY=
API_PROVIDER_CUSTOM_API_15_KEY=
API_PROVIDER_CUSTOM_API_16_KEY=
API_PROVIDER_CUSTOM_API_17_KEY=
API_PROVIDER_CUSTOM_API_18_KEY=

# 服务与数据
SMART_CANVAS_PORT=3001
LOCAL_IMAGE_IMPORT_MAX_BYTES=52428800
# SMART_CANVAS_DATA_DIR=

# 模型清单
CHAT_MODEL=gpt-4o-mini
IMAGE_MODEL=gpt-image-2
CHAT_MODELS=
IMAGE_MODELS=
VIDEO_MODELS=

# 系统与对话
SYSTEM_PROMPT="You are a helpful assistant."
MAX_HISTORY_MESSAGES=30
LLM_MESSAGE_MAX_LENGTH=20000
CHAT_ATTACHMENT_MAX=20
ONLINE_IMAGE_PROMPT_MAX_LENGTH=20000
ONLINE_IMAGE_REFERENCE_MAX=20

# 超时与轮询
REQUEST_TIMEOUT=1800
IMAGE_POLL_INTERVAL=2
IMAGE_TASK_TIMEOUT=1800
APIMART_IMAGE_TASK_TIMEOUT=1800
APIMART_IMAGE_POLL_INTERVAL=5
APIMART_IMAGE_INITIAL_POLL_DELAY=10
TUDOU_ASYNC_IMAGE_TASK_TIMEOUT=1800
TUDOU_ASYNC_IMAGE_POLL_INTERVAL=4
TUDOU_ASYNC_IMAGE_INITIAL_POLL_DELAY=12
VIDEO_POLL_TIMEOUT=1800
VIDEO_PROMPT_MAX_LENGTH=4000

# 云端上传/临时文件
APIMART_TRY_VIDEO_UPLOAD=0
TEMP_SH_MAX_BYTES=4294967296
LITTERBOX_UPLOAD_URL=https://litterbox.catbox.moe/resources/internals/api.php
LITTERBOX_TIME=72h
TEMP_SH_UPLOAD_URL=https://temp.sh/upload
CLOUD_VIDEO_UPLOAD_SERVICE=auto
